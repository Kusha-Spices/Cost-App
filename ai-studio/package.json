{
  "name": "aurora-studio",
  "productName": "Aurora Studio",
  "version": "0.1.0",
  "description": "AURORA — an AI-native creative studio. Direct it by voice or text; it generates, edits, animates and grades for you.",
  "author": "Kusha Spices",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/stress.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "icon": "python3 build/make_icon.py"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kushaspices.aurorastudio",
    "productName": "Aurora Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "mac": { "category": "public.app-category.graphics-design", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Graphics" }
  }
}
