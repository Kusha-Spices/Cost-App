# Copy this file to `.env`.

# ── Option A: FREE local brain (runs on your Mac, no key, no cost) ──
# 1) Install Ollama from https://ollama.com  2) run: ollama pull llama3.2
# 3) uncomment the next line:
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=llama3.2      # or llama3.1 / qwen2.5 if you have 16GB+ RAM

# ── Option B: Paid Claude brain (most capable). Get a key at ──
# https://console.anthropic.com/ → API Keys, then paste it here:
ANTHROPIC_API_KEY=sk-ant-...

# ── Voice (how Jarvis sounds) ──
# Pick any installed macOS voice. See them with:  say -v "?"
# Premium/Siri voices and your Apple "Personal Voice" can be added in
# System Settings → Accessibility → Spoken Content → System Voice → Manage Voices.
# JARVIS_VOICE=Ava (Premium)
#
# Or speak in YOUR cloned voice (advanced — see speak_clone.py):
# JARVIS_TTS_CMD=./.venv/bin/python speak_clone.py
